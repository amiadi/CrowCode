{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "agent": {
      "description": "Agent configuration",
      "properties": {
        "maxTokens": {
          "description": "Maximum tokens for the agent",
          "minimum": 1,
          "type": "integer"
        },
        "model": {
          "description": "Model ID for the agent",
          "enum": [
            "gpt-4.1",
            "llama-3.3-70b-versatile",
            "azure.gpt-4.1",
            "openrouter.gpt-4o",
            "openrouter.o1-mini",
