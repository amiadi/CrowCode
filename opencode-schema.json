              "openrouter.gemini-2.5",
              "o1-mini",
              "azure.gpt-4o",
              "openrouter.gpt-4.1-mini",
              "openrouter.claude-3.5-sonnet",
              "openrouter.o3-mini",
              "gpt-4.1-mini",
              "gpt-4.5-preview",
              "gpt-4.1-nano",
              "deepseek-r1-distill-llama-70b",
              "azure.gpt-4o-mini",
              "openrouter.gpt-4.1",
              "bedrock.claude-3.7-sonnet",
              "claude-3-haiku",
              "o3",
              "gemini-2.0-flash-lite",
              "azure.o3",
              "azure.gpt-4.5-preview",
              "openrouter.claude-3-opus",
              "grok-3-mini-fast-beta",
              "claude-4-sonnet",
              "azure.o4-mini",
              "grok-3-fast-beta",
              "claude-3.5-sonnet",
              "azure.o1-mini",
              "openrouter.claude-3.7-sonnet",
              "openrouter.gpt-4.5-preview",
              "grok-3-mini-beta",
              "claude-3.7-sonnet",
              "gemini-2.0-flash",
              "openrouter.deepseek-r1-free",
              "vertexai.gemini-2.5-flash",
              "vertexai.gemini-2.5",
              "o1-pro",
              "gemini-2.5",
              "meta-llama/llama-4-scout-17b-16e-instruct",
              "azure.gpt-4.1-nano",
              "openrouter.gpt-4.1-nano",
              "gemini-2.5-flash",
              "openrouter.o4-mini",
              "openrouter.claude-3.5-haiku",
              "claude-4-opus",
              "openrouter.o1-pro",
              "copilot.gpt-4o",
              "copilot.gpt-4o-mini",
              "copilot.gpt-4.1",
              "copilot.claude-3.5-sonnet",
              "copilot.claude-3.7-sonnet",
              "copilot.claude-sonnet-4",
              "copilot.o1",
              "copilot.o3-mini",
              "copilot.o4-mini",
              "copilot.gemini-2.0-flash",
              "copilot.gemini-2.5-pro"
            ],
            "type": "string"
          },
          "reasoningEffort": {
            "description": "Reasoning effort for models that support it (OpenAI, Anthropic)",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          },
          "temperature": {
            "description": "Sampling temperature for OpenAI-compatible providers",
            "minimum": 0,
            "maximum": 2,
            "type": "number"
          },
          "topP": {
            "description": "Top-p nucleus sampling for OpenAI-compatible providers",
            "minimum": 0,
            "maximum": 1,
            "type": "number"
          },
          "minP": {
            "description": "Minimum probability filter for local Ollama-compatible providers",
            "minimum": 0,
            "maximum": 1,
            "type": "number"
          },
          "topK": {
            "description": "Top-k sampling limit for local Ollama-compatible providers",
            "minimum": 0,
            "type": "integer"
          },
          "numCtx": {
            "description": "Context window override for local Ollama-compatible providers",
            "minimum": 1,
            "type": "integer"
          },
          "repeatPenalty": {
            "description": "Repeat penalty for local Ollama-compatible providers",
            "minimum": 0,
            "type": "number"
          },
          "seed": {
            "description": "Random seed for deterministic OpenAI-compatible sampling",
            "type": "integer"
          }
        },
        "required": [
          "model"
        ],
        "type": "object"
      },
      "description": "Agent configurations",
      "properties": {
        "coder": {
          "$ref": "#/definitions/agent"
        },
        "task": {
          "$ref": "#/definitions/agent"
        },
        "title": {
          "$ref": "#/definitions/agent"
        }
      },
      "type": "object"
    },
    "contextPaths": {
      "default": [
        ".github/copilot-instructions.md",
        ".cursorrules",
        ".cursor/rules/",
        "CLAUDE.md",
        "CLAUDE.local.md",
        "crowcode.md",
        "crowcode.local.md",
        "CrowCode.md",
        "CrowCode.local.md",
        "OPENCODE.md",
        "OPENCODE.local.md"
      ],
      "description": "Context paths for the application",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "data": {
      "description": "Storage configuration",
      "properties": {
        "directory": {
          "default": ".crowcode",
          "description": "Directory where application data is stored",
          "type": "string"
        }
      },
      "required": [
        "directory"
      ],
      "type": "object"
    },
    "debug": {
      "default": false,
      "description": "Enable debug mode",
      "type": "boolean"
    },
    "debugLSP": {
      "default": false,
      "description": "Enable LSP debug mode",
      "type": "boolean"
    },
    "localOnly": {
      "default": false,
      "description": "When true, disable non-local providers and force all agents to use local models",
      "type": "boolean"
    },
    "localEndpoint": {
      "description": "Base URL for local OpenAI-compatible servers (Ollama, vLLM, SGLang)",
      "examples": [
        "http://127.0.0.1:11434",
        "http://192.168.1.10:8000",
        "http://10.0.0.5:30000"
      ],
      "type": "string"
    },
    "python": {
      "description": "Python tool runner configuration",
      "properties": {
        "defaultTimeoutMs": {
          "default": 60000,
          "description": "Default timeout for Python script tools in milliseconds",
          "type": "integer"
        },
        "enabled": {
          "default": false,
          "description": "Enable Python script tools",
          "type": "boolean"
        },
        "interpreter": {
          "default": "python3",
          "description": "Python interpreter executable",
          "type": "string"
        },
        "requirePermission": {
          "default": true,
          "description": "Require per-execution permission by default for Python tools",
          "type": "boolean"
        },
        "tools": {
          "additionalProperties": {
            "properties": {
              "args": {
                "description": "Static arguments always passed to the script",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "env": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables for the script",
                "type": "object"
              },
              "path": {
                "description": "Script path (absolute or relative to working directory)",
                "type": "string"
              },
              "requirePermission": {
                "description": "Override default permission requirement for this script",
                "type": "boolean"
              },
              "timeoutMs": {
                "description": "Timeout for this script in milliseconds",
                "type": "integer"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "description": "Named Python script tools exposed to the agent",
          "type": "object"
        }
      },
      "type": "object"
    },
    "rag": {
      "description": "Retrieval-augmented generation configuration",
      "properties": {
        "embeddings": {
          "properties": {
            "dimensions": {
              "default": 768,
              "description": "Embedding vector dimensions",
              "type": "integer"
            },
            "model": {
              "default": "nomic-embed-text",
              "description": "Embedding model name",
              "type": "string"
            },
            "provider": {
              "default": "ollama",
              "description": "Embedding provider (ollama, hash)",
              "enum": [
                "ollama",
                "hash",
                "local"
              ],
              "type": "string"
            },
            "timeoutMs": {
              "default": 15000,
              "description": "Embedding request timeout in milliseconds",
              "type": "integer"
            }
          },
          "type": "object"
        },
        "enabled": {
          "default": true,
          "description": "Enable chat-time RAG augmentation",
          "type": "boolean"
        },
        "maxContextChars": {
          "default": 3200,
          "description": "Maximum characters injected from retrieved context",
          "type": "integer"
        },
        "minScore": {
          "default": 0.2,
          "description": "Minimum hybrid score for injection",
          "type": "number"
        },
        "topK": {
          "default": 5,
          "description": "Number of retrieval results",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "lsp": {
      "additionalProperties": {
        "description": "LSP configuration for a language",
        "properties": {
          "args": {
            "description": "Command arguments for the LSP server",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "command": {
            "description": "Command to execute for the LSP server",
            "type": "string"
          },
          "disabled": {
            "default": false,
            "description": "Whether the LSP is disabled",
            "type": "boolean"
          },
          "options": {
            "description": "Additional options for the LSP server",
            "type": "object"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      },
      "description": "Language Server Protocol configurations",
      "type": "object"
    },
    "mcpServers": {
      "additionalProperties": {
        "description": "MCP server configuration",
        "properties": {
          "args": {
            "description": "Command arguments for the MCP server",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "command": {
            "description": "Command to execute for the MCP server",
            "type": "string"
          },
          "env": {
            "description": "Environment variables for the MCP server",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "HTTP headers for SSE type MCP servers",
            "type": "object"
          },
          "type": {
            "default": "stdio",
            "description": "Type of MCP server",
            "enum": [
              "stdio",
              "sse"
            ],
            "type": "string"
          },
          "url": {
            "description": "URL for SSE type MCP servers",
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      },
      "description": "Model Control Protocol server configurations",
      "type": "object"
    },
    "providers": {
      "additionalProperties": {
        "description": "Provider configuration",
        "properties": {
          "apiKey": {
            "description": "API key for the provider",
            "type": "string"
          },
          "disabled": {
            "default": false,
            "description": "Whether the provider is disabled",
            "type": "boolean"
          },
          "provider": {
            "description": "Provider type",
            "enum": [
              "anthropic",
              "openai",
              "gemini",
              "groq",
              "openrouter",
              "bedrock",
              "azure",
              "vertexai",
              "copilot"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "description": "LLM provider configurations",
      "type": "object"
    },
    "tui": {
      "description": "Terminal User Interface configuration",
      "properties": {
        "theme": {
          "default": "crowcode",
          "description": "TUI theme name",
          "enum": [
            "crowcode",
            "catppuccin",
            "dracula",
            "flexoki",
            "gruvbox",
            "monokai",
            "onedark",
            "tokyonight",
            "tron"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "wd": {
      "description": "Working directory for the application",
      "type": "string"
    }
  },
  "title": "CrowCode Configuration",
  "type": "object"
}
