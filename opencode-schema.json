            "o1",
            "meta-llama/llama-4-maverick-17b-128e-instruct",
            "azure.o3-mini",
            "openrouter.gpt-4o-mini",
            "openrouter.o1",
            "claude-3.5-haiku",
            "o4-mini",
            "azure.gpt-4.1-mini",
            "openrouter.o3",
            "grok-3-beta",
            "o3-mini",
            "qwen-qwq",
            "azure.o1",
            "openrouter.gemini-2.5-flash",
            "openrouter.gemini-2.5",
            "o1-mini",
            "azure.gpt-4o",
            "openrouter.gpt-4.1-mini",
            "openrouter.claude-3.5-sonnet",
            "openrouter.o3-mini",
            "gpt-4.1-mini",
            "gpt-4.5-preview",
            "gpt-4.1-nano",
            "deepseek-r1-distill-llama-70b",
            "azure.gpt-4o-mini",
            "openrouter.gpt-4.1",
            "bedrock.claude-3.7-sonnet",
            "claude-3-haiku",
            "o3",
            "gemini-2.0-flash-lite",
            "azure.o3",
            "azure.gpt-4.5-preview",
            "openrouter.claude-3-opus",
            "grok-3-mini-fast-beta",
            "claude-4-sonnet",
            "azure.o4-mini",
            "grok-3-fast-beta",
            "claude-3.5-sonnet",
            "azure.o1-mini",
            "openrouter.claude-3.7-sonnet",
            "openrouter.gpt-4.5-preview",
            "grok-3-mini-beta",
            "claude-3.7-sonnet",
            "gemini-2.0-flash",
            "openrouter.deepseek-r1-free",
            "vertexai.gemini-2.5-flash",
            "vertexai.gemini-2.5",
            "o1-pro",
            "gemini-2.5",
            "meta-llama/llama-4-scout-17b-16e-instruct",
            "azure.gpt-4.1-nano",
            "openrouter.gpt-4.1-nano",
            "gemini-2.5-flash",
            "openrouter.o4-mini",
            "openrouter.claude-3.5-haiku",
            "claude-4-opus",
            "openrouter.o1-pro",
            "copilot.gpt-4o",
            "copilot.gpt-4o-mini",
            "copilot.gpt-4.1",
            "copilot.claude-3.5-sonnet",
            "copilot.claude-3.7-sonnet",
            "copilot.claude-sonnet-4",
            "copilot.o1",
            "copilot.o3-mini",
            "copilot.o4-mini",
            "copilot.gemini-2.0-flash",
            "copilot.gemini-2.5-pro"
          ],
          "type": "string"
        },
        "reasoningEffort": {
          "description": "Reasoning effort for models that support it (OpenAI, Anthropic)",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        "temperature": {
          "description": "Sampling temperature for OpenAI-compatible providers",
          "minimum": 0,
          "maximum": 2,
          "type": "number"
        },
        "topP": {
          "description": "Top-p nucleus sampling for OpenAI-compatible providers",
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "minP": {
          "description": "Minimum probability filter for local Ollama-compatible providers",
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "topK": {
          "description": "Top-k sampling limit for local Ollama-compatible providers",
          "minimum": 0,
          "type": "integer"
        },
        "numCtx": {
          "description": "Context window override for local Ollama-compatible providers",
          "minimum": 1,
          "type": "integer"
        },
        "repeatPenalty": {
          "description": "Repeat penalty for local Ollama-compatible providers",
          "minimum": 0,
          "type": "number"
        },
        "seed": {
          "description": "Random seed for deterministic OpenAI-compatible sampling",
          "type": "integer"
        }
      },
      "required": [
        "model"
      ],
      "type": "object"
    }
  },
  "description": "Configuration schema for the CrowCode application",
  "properties": {
    "agents": {
      "additionalProperties": {
        "description": "Agent configuration",
        "properties": {
          "maxTokens": {
            "description": "Maximum tokens for the agent",
            "minimum": 1,
            "type": "integer"
          },
          "model": {
            "description": "Model ID for the agent",
            "enum": [
              "gpt-4.1",
              "llama-3.3-70b-versatile",
              "azure.gpt-4.1",
              "openrouter.gpt-4o",
              "openrouter.o1-mini",
              "openrouter.claude-3-haiku",
              "claude-3-opus",
              "gpt-4o",
              "gpt-4o-mini",
              "o1",
              "meta-llama/llama-4-maverick-17b-128e-instruct",
              "azure.o3-mini",
